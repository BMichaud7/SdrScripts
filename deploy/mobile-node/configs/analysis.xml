<?xml version="1.0" encoding="UTF-8"?>
<sdr_analysis>
  <scanner_id>analysis-0</scanner_id>
  <streaming_ip>127.0.0.1</streaming_ip>

  <amqp>
    <url>amqp://localhost:5672</url>
    <username>sdr_ctrl</username>
    <password>sdr_hw_test</password>
    <detections_topic>rf.detections</detections_topic>
    <analysis_topic>rf.analysis</analysis_topic>
    <task_request_queue>sdr.task.request</task_request_queue>
    <task_response_queue>sdr.task.response</task_response_queue>
    <demod_request_queue>rf.demod.request</demod_request_queue>
  </amqp>

  <database>
    <host>localhost</host>
    <port>5432</port>
    <name>sdr_scanner</name>
    <user>sdr</user>
    <password>sdr_hw_test</password>
  </database>

  <collector>
    <analysis_sample_rate_sps>2000000</analysis_sample_rate_sps>
    <collect_samples>65536</collect_samples>
    <analysis_timeout_ms>10000</analysis_timeout_ms>
  </collector>

  <engine>
    <fft_size>4096</fft_size>
    <snr_threshold_db>5.0</snr_threshold_db>
    <rank>2</rank>
    <!-- model_path/classes_path point at where entrypoint.sh auto-downloads
         the latest published model (see ANALYSIS_MODEL in entrypoint.sh) --
         leave model_path empty to disable ONNX classification entirely.
         ENABLE_SDR_ANALYSIS defaults to false on mobile-node (see
         entrypoint.sh), so this is inert unless explicitly turned on. -->
    <onnx>
      <model_path>/etc/sdr-analysis/models/amr_cnn_24class.onnx</model_path>
      <classes_path>/etc/sdr-analysis/models/amr_cnn_24class.classes.json</classes_path>
      <!-- mobile-node targets aarch64/low-power boards, no CUDA -->
      <use_gpu>false</use_gpu>
      <use_tensorrt>false</use_tensorrt>
      <input_len>1024</input_len>
    </onnx>
  </engine>
</sdr_analysis>
