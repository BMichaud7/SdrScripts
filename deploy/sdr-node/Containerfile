# ══════════════════════════════════════════════════════════════════════════════
# OpenRFStack — All-in-one SDR Node
# Rocky Linux 9 headless + k3s orchestrator
#
# First run: pulls latest RPMs from GitHub Releases and installs them.
# Subsequent runs: RPMs already installed, starts k3s and applies manifests.
#
# Build (from SdrScripts/):
#   podman build -t openrfstack-node:latest -f deploy/sdr-node/Containerfile .
#
# Run:
#   podman run -d --name sdr-node \
#     --privileged \
#     --cgroupns=host \
#     --network host \
#     -e GITHUB_TOKEN=<your-token> \
#     -v sdr-data:/var/lib/sdr:z \
#     -v sdr-k3s:/var/lib/rancher/k3s:z \
#     openrfstack-node:latest
#
# To override which services run (edit node.conf, then mount it):
#   -v /path/to/node.conf:/etc/sdr/node.conf:ro,z
# To override device config (e.g. for RTL-SDR instead of PlutoSDR):
#   -v /path/to/devices.xml:/etc/sdr/devices.xml:ro,z
# ══════════════════════════════════════════════════════════════════════════════
FROM rockylinux:9

ENV LANG=C.UTF-8

# ── Runtime library dependencies for SDR binaries ────────────────────────────
RUN dnf install -y epel-release && \
    dnf install -y --allowerasing \
        SoapySDR \
        qpid-proton-cpp \
        tinyxml2 \
        spdlog \
        fmt \
        fftw \
        libpq \
        curl \
        procps-ng \
    && dnf clean all

# ── GitHub CLI (for release asset downloads) ─────────────────────────────────
RUN dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo && \
    dnf install -y gh && \
    dnf clean all

# ── k3s (binary only — no systemd needed at runtime) ─────────────────────────
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
    K3S_BIN=$([ "$ARCH" = "amd64" ] && echo "k3s" || echo "k3s-${ARCH}") && \
    TAG=$(curl -sfL https://api.github.com/repos/k3s-io/k3s/releases/latest \
          | grep -m1 '"tag_name"' | cut -d'"' -f4) && \
    ENCODED_TAG=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$TAG") && \
    curl -sfL "https://github.com/k3s-io/k3s/releases/download/${ENCODED_TAG}/${K3S_BIN}" \
         -o /usr/local/bin/k3s && \
    chmod +x /usr/local/bin/k3s && \
    mkdir -p /var/lib/rancher/k3s /etc/rancher/k3s

# ── Bundle manifests and default configs ─────────────────────────────────────
COPY deploy/sdr-node/k8s/     /opt/sdr-node/k8s/
COPY deploy/sdr-node/configs/ /opt/sdr-node/configs/
COPY deploy/sdr-node/entrypoint.sh /opt/sdr-node/entrypoint.sh
RUN chmod +x /opt/sdr-node/entrypoint.sh

# Persistent volumes:
#   /var/lib/sdr      — PostgreSQL data, SQLite transcripts, demod output
#   /var/lib/rancher/k3s — k3s state, containerd image cache
VOLUME ["/var/lib/sdr", "/var/lib/rancher/k3s"]

ENTRYPOINT ["/opt/sdr-node/entrypoint.sh"]
