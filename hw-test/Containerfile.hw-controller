# ============================================================================
#  hw-controller — SdrResourceManager with direct PlutoSDR support
#
#  Reuses pre-built libiio v0.26, libad9361, and libPlutoSDRSupport.so from
#  the soapy-pluto:1.0 image — no SoapySDRServer intermediary needed.
#  Direct path: controller → libiio → PlutoSDR (~5-8 ms/hop vs ~33 ms via remote)
#
#  Build (from /home/brendan, parent of all repos):
#    podman build --no-cache -t sdr-controller-hw:3.0 \
#      -f hw-test/Containerfile.hw-controller .
#
#  Run:
#    podman run --rm --network=host \
#      -v $(pwd)/hw-test/devices-direct-eth.xml:/etc/sdr-controller/devices.xml:ro \
#      -e PLUTO_IP=192.168.1.253 \
#      sdr-controller-hw:3.0 /etc/sdr-controller/devices.xml
# ============================================================================

# Stage 0: pre-built PlutoSDR libraries (libiio v0.26 + libad9361 + patched SoapyPlutoSDR)
FROM localhost/soapy-pluto:1.0 AS pluto-stage

# Stage 1: build SdrResourceManager
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config git ca-certificates \
    libsoapysdr-dev \
    libqpid-proton-cpp12-dev \
    libtinyxml2-dev \
    libfmt-dev \
    libspdlog-dev \
    nlohmann-json3-dev \
    libfftw3-dev \
    uuid-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY SdrTaskApi/         /build/SdrTaskApi/
COPY SdrResourceManager/ /build/SdrResourceManager/
RUN rm -rf /build/SdrResourceManager/build

RUN cmake -S /build/SdrResourceManager -B /build/SdrResourceManager/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/install \
        -DCMAKE_PREFIX_PATH=/usr/local \
    && cmake --build /build/SdrResourceManager/build --parallel "$(nproc)" \
    && cmake --install /build/SdrResourceManager/build

# Stage 2: runtime
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0 libxml2 libavahi-client3 \
    libsoapysdr0.8 soapysdr-tools \
    libqpid-proton-cpp12 \
    libtinyxml2-10 \
    libfmt9 \
    libspdlog1.12 \
    libuuid1 \
    libfftw3-single3 \
    tini \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# SdrResourceManager binaries + default config
COPY --from=builder /install/ /usr/local/

# libiio v0.26 + libad9361 (source-built in soapy-pluto, compatible with PlutoSDR iiod 0.26)
COPY --from=pluto-stage /usr/local/lib/libiio.so.0.26   /usr/local/lib/libiio.so.0.26
COPY --from=pluto-stage /usr/local/lib/libad9361.so.0.4 /usr/local/lib/libad9361.so.0.4
# SoapyPlutoSDR module (patched to support PLUTO_IP env var for network discovery)
COPY --from=pluto-stage /usr/local/lib/SoapySDR/modules0.8/libPlutoSDRSupport.so \
                         /usr/local/lib/SoapySDR/modules0.8/libPlutoSDRSupport.so

RUN ln -sf libiio.so.0.26   /usr/local/lib/libiio.so.0   && \
    ln -sf libiio.so.0.26   /usr/local/lib/libiio.so     && \
    ln -sf libad9361.so.0.4 /usr/local/lib/libad9361.so.0 && \
    ln -sf libad9361.so.0.4 /usr/local/lib/libad9361.so   && \
    echo /usr/local/lib > /etc/ld.so.conf.d/local.conf && ldconfig

# Verify PlutoSDR module is present
RUN SoapySDRUtil --info 2>&1 | grep -iE "pluto|factories" || true

ENV SDR_LOG_LEVEL=info
ENV PLUTO_IP=192.168.1.253

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/sdr_controller"]
